{
  "verificationCommands": ["bash verify.sh"],
  "sourceDirs": ["src"],
  "defaultBudgets": {
    "buildTurnsFactor": 2,
    "buildHours": 2,
    "improveTurns": 50,
    "improveUsd": 25,
    "improveFindings": 3
  },
  "improve": { "enabled": false },
  "reviewFocus": ["code-quality", "test-coverage", "architecture", "security", "bug"],
  "models": { "go": "sonnet", "builder": "sonnet", "verifier": "inherit" },
  "artifactPaths": { "specs": "specs", "reviewOutput": "review-output" }
}
